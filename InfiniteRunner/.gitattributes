# Normalize line endings: store text as LF in the repo, check out native on each OS.
# Prevents whitespace-only diffs between Windows/macOS collaborators.
* text=auto

# C# source
*.cs text diff=csharp eol=lf

# Unity YAML text assets: force LF and use Unity's SmartMerge tool for conflicts.
# (SmartMerge must be configured per-machine to actually run; harmless otherwise.)
*.unity           merge=unityyamlmerge eol=lf
*.prefab          merge=unityyamlmerge eol=lf
*.asset           merge=unityyamlmerge eol=lf
*.meta            merge=unityyamlmerge eol=lf
*.mat             merge=unityyamlmerge eol=lf
*.anim            merge=unityyamlmerge eol=lf
*.controller      merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.physicMaterial2D merge=unityyamlmerge eol=lf
*.physicMaterial  merge=unityyamlmerge eol=lf
*.playerprefs     merge=unityyamlmerge eol=lf

# Binary assets: never diff, merge, or line-ending-munge these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.psd  binary
*.tga  binary
*.tif  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.aif  binary
*.fbx  binary
*.blend binary
*.ttf  binary
*.otf  binary
*.dll  binary
*.unitypackage binary
